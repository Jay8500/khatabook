{
  "name": "khatabk",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:index": "node scripts/check-index.mjs",
    "prebuild": "node scripts/check-index.mjs && node scripts/build-info.mjs",
    "netlify:deploy": "netlify deploy --dir=dist/khatabk/browser --no-build",
    "netlify:deploy:prod": "netlify deploy --dir=dist/khatabk/browser --no-build --prod",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push",
    "supabase:functions": "supabase functions deploy",
    "supabase:types": "supabase gen types typescript --linked --schema public > src/app/core/types/supabase.ts",
    "seed:settings": "node scripts/settings.seed.mjs",
    "build-info": "node scripts/build-info.mjs",
    "prestart": "node scripts/build-info.mjs",
    "pretest": "node scripts/build-info.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "html5-qrcode": "^2.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.0",
    "netlify-cli": "^27.10.1",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
